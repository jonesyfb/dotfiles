    {
      "input": "Are you actually useful?",
      "intent": "social_direct",
      "high_confidence": true,
      "intent_reason": "banter_about_huginn",
      "entity_mentions": [],
      "likely_used_direct_social_path": true,
      "response": "Useful is a loaded word, but if you mean \"do I get things done for you,\" then no\u2014I can't touch anything here. If you mean \"can I help you think about what you're trying to build,\" then sure. Just tell me what's actually on your mind, and we'll see where that leads.",
