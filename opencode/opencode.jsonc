{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "lsp": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (remote)",
      "options": {
        "baseURL": "http://10.0.0.2:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B (remote)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (remote)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5:27b": {
          "name": "Qwen 3.5 27B (remote)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "general": {
      "model": "openai/gpt-6-astra"
    },
    "explore": {
      "model": "ollama/qwen3.5:9b"
    },
    "docs": {
      "model": "ollama/qwen3.5:9b"
    },
    "test": {
      "model": "ollama/qwen3.5:27b"
    },
    "review": {
      "model": "ollama/qwen3.5:27b"
    }
  },
  "mcp": {
    "personal-mcp": {
      "type": "remote",
      "url": "https://mcp.poopenfarten.com/mcp",
      "enabled": true,
      "headers": {
        "CF-Access-Client-Id": "{env:CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "{env:CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
